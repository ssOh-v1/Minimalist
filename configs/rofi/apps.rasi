configuration {
    show-icons: true;
    drun-match-fields: "name";
}

* {
    background-color: #1e1e2e;   /* @bg0 — как основной фон модулей Waybar */
    text-color: #cdd6f4;         /* @fg */
    border-color: #89b4fa;       /* @blue — акцент как у активных модулей */
    font: "JetBrainsMono Nerd Font 13";
}

window {
    location: southwest;
    anchor: southwest;
    x-offset: 0px;
    y-offset: -200px;
    width: 400px;
    border: 1px;
    border-radius: 25px;
    background-color: #1e1e2e;
    padding: 16px;
}

mainbox {
    background-color: transparent;
    spacing: 10px;
}

listview {
    columns: 1;
    lines: 12;
    spacing: 4px;
    scrollbar: true;
    background-color: transparent;
}

scrollbar {
    width: 4px;
    handle-width: 4px;
    border-radius: 10px;
    background-color: #313244;   /* @bg2 — как кнопки воркспейсов */
    handle-color: #89b4fa;
}

element {
    padding: 8px 12px;
    border-radius: 20px;         /* как кнопки #workspaces */
    background-color: #313244;   /* @bg2 */
}

element selected {
    background-color: #89b4fa;   /* @blue */
    text-color: #313244;         /* @bg2 — тёмный текст на синем, как активный воркспейс */
}

element-text {
    vertical-align: 0.5;
}

element-icon {
    size: 1.4em;
    padding-right: 8px;
}

inputbar {
    padding: 8px;
    background-color: #313244;   /* @bg2 */
    border-radius: 20px;
    margin: 0px 0px 8px 0px;
    children: [ "prompt", "entry" ];
}

prompt {
    padding: 0 8px;
    color: #89b4fa;              /* @blue */
    font-weight: bold;
}

entry {
    placeholder: "Поиск приложений...";
    placeholder-color: #6c7086;  /* @grey0 */
}
